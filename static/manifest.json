		},
		{
			"src": "/icons/logo512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		}
	],
	"start_url": "/reader",
	"display": "standalone",
	"orientation": "portrait",
	"theme_color": "#000000",
	"background_color": "#000000"
}
